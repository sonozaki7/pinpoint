PINPOINT_MODE=demo            # demo | live | cloud
PINPOINT_HOST=127.0.0.1       # bind address; cloud keeps nginx on the same host
PINPOINT_PORT=8787
PINPOINT_TRUST_PROXY=0        # cloud: 1 behind nginx (trusts the first X-Forwarded-For hop only)
PINPOINT_SAMPLE_REPLY_MS=5000 # cloud: delay before the sample agent's reply appears
T3_URL=http://127.0.0.1:3773
T3_TOKEN=                     # ~/.t3/bin/t3 auth session issue ... --token-only
T3_PROJECTS=pinpoint          # privacy allowlist: project ids or exact titles, comma-separated. Required in live mode.
PINPOINT_ALLOWED_ORIGINS=     # live CORS: glasses origins, e.g. http://127.0.0.1:4173 (add null for an opaque WebView origin)
SPLITTER_PROVIDER=opencode    # opencode | anthropic | fixture
SPLITTER_MODEL=opencode-go/deepseek-v4.1-flash
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=           # empty = dry-run
TELEGRAM_CHAT_ID=
WHISPER_MODEL=                # whisper-cli ggml model; empty = find it or download base.en
WHISPER_THREADS=4             # whisper-cli threads

# Notion review pages: run node scripts/connect-notion.mjs, then paste its two lines.
NOTION_TOKEN=
NOTION_REVIEW_DB=             # "Docs" database id or data source id
NOTION_STATUS_PROP=Status     # status/select property holding Needs review | Changes requested | Approved
NOTION_NOTES_ROOT=            # "Pinpoint demo" page id (evidence for flags)

# Gmail draft review: node scripts/connect-google.mjs writes the token (gmail.modify only).
GMAIL_DRAFTS_QUERY=label:pinpoint  # which drafts are waiting for review

PINPOINT_SCRIPTED_TRANSCRIPTS= # demo recording: path to canned voice notes, e.g. ../demo/fixtures/transcripts.json
PINPOINT_DECK_FIXTURE=       # recording: JSON {"threadId":"mcp:...","deck":{...}} to pin one live thread's deck

# Cloud ignores T3_*, TELEGRAM_*, NOTION_*, GMAIL_*, SPLITTER_* and the API-key variables above.
# Cloud state (drafts, sent reviews, inbox status, agent replies) lives in memory
# per device: restarting the server wipes every device back to the sample workspace.
