{
  "name": "pinpoint-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "start:cloud": "tsx --env-file-if-exists=.env src/index.ts",
    "desk": "tsx --env-file-if-exists=.env src/desk.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "grammy": "^1.36.0",
    "hono": "^4.7.0",
    "tsx": "^4.19.0",
    "ws": "^8.23.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.0",
    "vitest": "^3.1.0"
  }
}
